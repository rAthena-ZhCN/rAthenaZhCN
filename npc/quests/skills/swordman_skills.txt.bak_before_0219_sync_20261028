		case 1:
			mes "[莱昂]";
			mes "哈哈，没什么特别的，就是一项攻击要害的技能！";
			next;
		case 2:
			mes "[莱昂]";
			mes "哈哈，没什么特别的，就是一项攻击要害的技能！";
			next;
