-	script	::KnightDeThomas	98,4,4,{
	if ((BaseClass == Job_Swordman) && (JobLevel >= 35 || (BaseJob == Job_Knight || BaseJob == Job_Crusader))) {
		if (getskilllv("SM_MOVINGRECOVERY") == 1) {
			mes "[德·托马斯]";
			mes "哦，是你啊？";
			mes "好久不见！";
			mes "你看起来比以前更健康了。";
			mes "哈哈哈哈！";
			mes "保重！后会有期！";
			close;
		} else if (countitem(713) >= 200 && countitem(1058) >= 1) {
			mes "[德·托马斯]";
			mes "欢迎回来……";
			mes "你准备好学习身体移动了吗？";
			next;
			switch (select("是。:不，我还没准备好。")) {
			case 1:
				mes "[德·托马斯]";
				mes "让我看看……";
				next;
				mes "[德·托马斯]";
				mes "好！我现在就教你……";
				mes "...The Body Movin' skill!";
				next;
				delitem 713,200; //Empty_Bottle
				delitem 1058,1; //Wing_Of_Moth
				skill "SM_MOVINGRECOVERY",1,SKILL_PERM;
				mes "[德·托马斯]";
				mes "就是这样！";
				mes "你自己试试看。";
				mes "但别过度。";
				next;
				mes "[德·托马斯]";
				mes "对了，我不需要你的";
				mes "盔甲了，你留着吧。";
				mes "祝你好运！";
				close;
			case 2:
				mes "[德·托马斯]";
				mes "是吗？";
				mes "那就准备好再来吧。";
				close;
			}
		} else {
			mes "[德·托马斯]";
			mes "嗯……他是个剑士……";
			mes "你知道我是德·托马斯·卡洛斯吧？";
			mes "普隆德拉第三骑兵队的骑士。";
			mes "德·托马斯·卡洛斯！";
			next;
			mes "[德·托马斯]";

			// bug: official script always states that job level is too low
			//mes "Wait a second, your Job level isn't above ^00880035^000000!";
			//mes "Come back when it is.";

			// custom: old dialog
			mes "我要求的物品你还没有集齐。";
			next;
			mes "[德·托马斯]";
			mes "记住，我需要^008800200个空瓶^000000、你的盔甲，以及一个^008800蛾翅^000000。全部集齐后再回来。";
			close;
		}
	} else {
		mes "[德·托马斯]";
		mes "我叫德·托马斯·卡洛斯。";
		mes "普隆德拉第三骑兵队的骑士。";
		mes "这些天我有项任务在身。";
		mes "咳咳！还需要我多说吗。";
		close;
	}
	end;

OnTouch:
	if ((BaseClass == Job_Swordman) && (JobLevel >= 35 || (BaseJob == Job_Knight || BaseJob == Job_Crusader))) {
		mes "[德·托马斯]";
		mes "哦，不！你一定受伤了！你没事吧？";
		mes "受了这么重的伤，你一定苦战过……";
		mes "身为剑士，必定伴随着许多责任与牺牲。";
		next;
		mes "[德·托马斯]";
		if (Sex == SEX_MALE)
			mes "对于这些剑士与骑士而言，有一项很棒的技能。";
		else
			mes "对于这些女剑士与骑士而言，有一项很棒的技能，小姑娘。";
		mes "我向你介绍——移动中恢复HP！";
		mes "身体移动是一项绝妙的技能";
		mes "能让你恢复体力（HP）";
		mes "在你移动的时候！";
		next;
		mes "[德·托马斯]";
		mes "它目前仍在开发中";
		mes "所以恢复量可能不多，";
		mes "但多少有些帮助。";
		mes "你觉得如何？想学习这项技能吗？";
		next;
		switch (select("好棒的技能！我想学！:不，谢谢。")) {
		case 1:
			mes "[德·托马斯]";
			mes "很好。我来告诉你学习这项技能需要什么。";
			mes "首先，你的Job等级必须高于^00880035^000000。";
			mes "你还需要^008800200个空瓶^000000。";
			mes "为什么？因为那证明你曾激烈战斗，用掉了那么多药水。";
			next;
			mes "[德·托马斯]";
			mes "还有，你在战斗中穿过的盔甲。";
			mes "这也是身经百战的证明。";
			mes "至于盔甲……你的盔甲正合适！";
			mes "带上你的盔甲！";
			mes "最后……给我带一个^008800蛾翅^000000来。";
			next;
			select("咦？你连那个也需要吗？");
			mes "[德·托马斯]";
			mes "也不算……我并不是真的需要它。";
			mes "只是我侄女暑假的假期作业是抓虫子。";
			mes "当然！我自己去弄会容易得多。";
			mes "但我必须一直在这里工作，实在没时间出去找。";
			next;
			mes "[德·托马斯]";
			mes "我每天只能待在一个地方，没法出门，你不觉得我很可怜吗？";
			mes "求你了，帮我找一个……*抽鼻子*";
			mes "如果你不帮我的话……";
			close;
		case 2:
			mes "[德·托马斯]";
			mes "...";
			close;
		}
	}
	end;
}

prt_in,75,88,5	script	莱昂·冯·弗里希	85,3,3,{
